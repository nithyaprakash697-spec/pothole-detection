# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Optional. Google Maps Platform API key with Maps JavaScript API & Geocoding API enabled.
# If not provided, RoadGuard AI seamlessly uses OpenStreetMap (OSM) and Nominatim reverse geocoding as a fallback.
VITE_GOOGLE_MAPS_API_KEY=""

# VITE_MODEL1_API_URL: Pothole Detection REST API base URL.
# Defaults to http://13.220.63.113:8000
VITE_MODEL1_API_URL="http://13.220.63.113:8000"

# VITE_MODEL2_ENDPOINT: Automated Road Damage Detection Hugging Face Space.
# Defaults to ProjectRoadDamageDetection/Automated-Road-Damage-Detection
VITE_MODEL2_ENDPOINT="ProjectRoadDamageDetection/Automated-Road-Damage-Detection"
